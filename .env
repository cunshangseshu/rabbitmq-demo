# ==============================
# RabbitMQ Docker 配置
# ==============================

# RabbitMQ 镜像
RABBITMQ_IMAGE=rabbitmq:4.3.4-management

# 容器名称
RABBITMQ_CONTAINER_NAME=rabbitmq-learning

# RabbitMQ AMQP 对外端口
RABBITMQ_PORT=5673

# RabbitMQ Management 对外端口
RABBITMQ_MANAGEMENT_PORT=15673

# RabbitMQ 用户
RABBITMQ_USERNAME=study

# RabbitMQ 密码
RABBITMQ_PASSWORD=study123

# Virtual Host
RABBITMQ_VHOST=/